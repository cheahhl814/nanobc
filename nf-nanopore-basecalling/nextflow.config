manifest {
    name = 'nf-nanopore-basecalling'
    description = 'Dorado-based Nanopore basecalling, demultiplexing, and QC pipeline'
    version = '0.1.0'
    nextflowVersion = '>=23.04.0'
}

params {
    outdir = "${launchDir}/results"
}

def timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace_${timestamp}.txt"
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report_${timestamp}.html"
}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline_${timestamp}.html"
}

// Parameters for different processes
profiles {
    slurm {
        process {
            executor = 'slurm'
            withLabel: 'dorado' {
                clusterOptions = '--partition=highprio --gres=gpu:3g.39gb:1 --job-name=dorado'
                memory = '40 GB'
            }
            withLabel: 'samtools' {
                clusterOptions = '--partition=cpu1 --job-name=samtools'
                cpus = 2
                memory = '20 GB'
            }
            withLabel: 'seqtk' {
                clusterOptions = '--partition=cpu1 --job-name=seqtk'
                cpus = 2
                memory = '20 GB'
            }
            withLabel: 'transfer' {
                executor = 'local'
            }
        }
    }
    local {
        process {
            executor = 'local'
            withLabel: 'dorado' {
                cpus = 4
                memory = '40 GB'
            }
            withLabel: 'samtools' {
                cpus = 2
                memory = '20 GB'
            }
            withLabel: 'seqtk' {
                cpus = 2
                memory = '20 GB'
            }
        }
    }
}

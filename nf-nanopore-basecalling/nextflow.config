manifest {
    name = 'nf-nanopore-basecalling'
    description = 'Dorado-based Nanopore basecalling, demultiplexing, and QC pipeline'
    version = '0.1.0'
    nextflowVersion = '>=23.04.0'
}

params {
    outdir = "${launchDir}/results"
}

def timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace_${timestamp}.txt"
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report_${timestamp}.html"
}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline_${timestamp}.html"
}

// Parameters for different processes
// NOTE: the SLURM clusterOptions below are PLACEHOLDERS (<gpu_partition>,
// <gpu_gres>, <cpu_partition>) — they will not run on any real cluster until
// replaced. Real values belong in a gitignored nextflow.config.<cluster>.local
// applied via `-c` (see nanobc-preflight §2.5c/d — check sinfo, ask, write).
profiles {
    slurm {
        process {
            executor = 'slurm'
            withLabel: 'dorado' {
                clusterOptions = '--partition=<gpu_partition> --gres=gpu:<gpu_gres>:1 --job-name=dorado'
                memory = '40 GB'
            }
            withLabel: 'samtools' {
                clusterOptions = '--partition=<cpu_partition> --job-name=samtools'
                cpus = 2
                memory = '20 GB'
            }
            withLabel: 'seqtk' {
                clusterOptions = '--partition=<cpu_partition> --job-name=seqtk'
                cpus = 2
                memory = '20 GB'
            }
            withLabel: 'transfer' {
                executor = 'local'
            }
        }
    }
    local {
        process {
            executor = 'local'
            withLabel: 'dorado' {
                cpus = 4
                memory = '40 GB'
            }
            withLabel: 'samtools' {
                cpus = 2
                memory = '20 GB'
            }
            withLabel: 'seqtk' {
                cpus = 2
                memory = '20 GB'
            }
        }
    }
}
